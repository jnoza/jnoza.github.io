---
import BaseLayout from "../layouts/BaseLayout.astro";
import TerminalWindow from "../components/TerminalWindow.astro";

const competencies = [
  { category: "Leadership", items: ["Executive Advisory (CISO-level)", "Strategic Budgeting & Roadmapping", "Talent Development & Retention", "Threat-Informed Defense Strategy", "SOC & Incident Response Integration"] },
  { category: "Agentic AI & Automation", items: ["Agentic AI Vulnerability Discovery", "LLM Security & Exploitation", "Claude Code · Gemini-CLI · Shannon AI", "AI Risk Management", "Automation Scaling"] },
  { category: "Offensive Security", items: ["Web Application & Cloud Penetration Testing", "AWS · GCP · Azure Infrastructure Testing", "FedRAMP 3PAO Assessments", "Internal / External Penetration Testing", "Microsoft Azure & Office 365 Security"] },
  { category: "Tools & Languages", items: ["Bash · Python", "Burp Suite Pro · Tenable Nessus", "Rapid7 InsightVM · AppSpider Enterprise", "Bilingual: English & Spanish"] },
];

const experience = [
  {
    role: "Manager, Offensive Security",
    org: "Tevora Business Solutions, Inc — Fairfax, VA",
    period: "07/2022 — Present",
    bullets: [
      "Lead a high-performing offensive security team of 5 direct reports and a rotating pipeline of 2–3 interns per cycle.",
      "Serve as strategic advisor to external CISOs and senior security leadership, translating complex threat findings into prioritized remediation roadmaps tailored to each client's business risk.",
      "2× President's Club Award winner for consistently exceeding department revenue goals, currently scaling past $9.2M annually.",
      "Pioneer Agentic AI testing strategy using Claude Code, Gemini-CLI, and Shannon AI to scale vulnerability discovery — identifying complex logic flaws and zero-day vulnerabilities that bypass traditional automated analysis.",
      "Technical lead for the organization's successful FedRAMP 3PAO certification; spearhead cloud penetration tests for Cloud Service Providers through rigorous compliance and threat modeling.",
      "Foster a culture of continuous learning with exceptionally low turnover; mentor engineers to advanced certifications (e.g., OSWE) and expanded enterprise capabilities.",
    ],
  },
  {
    role: "Information Security Consultant",
    org: "Tevora Business Solutions, Inc — Fairfax, VA",
    period: "03/2020 — 07/2022",
    bullets: [
      "Primary technical resource for penetration testing and vulnerability remediation, leading complex network, web application, and cloud infrastructure engagements.",
      "Conducted comprehensive penetration tests across internal and external environments, cloud infrastructure, and PCI-DSS compliance frameworks.",
      "Communicated findings and remediation strategies through detailed executive and technical reporting.",
    ],
  },
  {
    role: "Cyber Security Engineer",
    org: "State Corporation Commission — Richmond, VA",
    period: "01/2016 — 03/2020",
    bullets: [
      "Managed the Vulnerability Management program; revamped it to include vulnerability validation that prioritized known exploitable vulnerabilities using Rapid7 InsightVM and AppSpider Enterprise.",
      "Security team lead on Cloud Migration Project — Office 365/ADFS migration including Exchange Online, Office Online, and SharePoint Online.",
      "Created Hardening Standards using DoD STIGs for Windows and Windows Server environments.",
      "Received advanced training in Red Team Penetration Testing and Cloud Exploitation at Black Hat 2017 & 2019.",
    ],
  },
  {
    role: "Systems Analyst II, Risk and Security",
    org: "Virginia Premier Health Plan, Inc. — Richmond, VA",
    period: "06/2013 — 01/2016",
    bullets: [
      "Implemented security controls to improve a nascent security and risk program; documented SOPs to standardize performance across processes.",
      "Implemented a monthly server patch management process and a Security Awareness program including annual training, monthly newsletters, and quarterly contests.",
      "Deployed a SIEM tool to centralize events and improve incident response time.",
    ],
  },
];

const education = [
  {
    school: "B.S. Information Systems — Spring 2013",
    detail: "Virginia Commonwealth University, Richmond, VA",
  },
];

const certifications = [
  { name: "CISSP — Certified Information Systems Security Professional", validity: "2023 – 2028" },
  { name: "GPEN — GIAC Penetration Tester", validity: "2019 – 2027" },
  { name: "OSCP — Offensive Security Certified Professional", validity: "2019" },
];
---
<BaseLayout>
  <!-- Hero -->
  <section class="mx-auto max-w-5xl px-5 sm:px-8 pt-16 sm:pt-24 pb-12">
    <div class="flex items-center gap-2 font-mono text-xs text-[var(--color-fg-dim)] mb-6">
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)] shadow-[0_0_8px_var(--color-accent)]"></span>
      <span>session.active</span>
      <span class="text-[var(--color-line)]">|</span>
      <span>uplink ok</span>
      <span class="text-[var(--color-line)]">|</span>
      <span>auth: pubkey</span>
    </div>

    <h1 class="font-mono text-4xl sm:text-6xl font-semibold tracking-tight leading-[1.05]">
      <span class="text-[var(--color-fg-muted)]">&gt;</span>
      <span class="text-[var(--color-fg)]">jn0xa</span>
      <span class="ml-1 inline-block h-9 sm:h-12 w-2 align-middle bg-[var(--color-accent)] animate-pulse"></span>
    </h1>

    <p class="mt-5 max-w-2xl text-lg sm:text-xl text-[var(--color-fg-muted)] leading-relaxed">
      <span class="text-[var(--color-accent)]">Strategic Offensive Security Leader.</span>
      Managing high-performing penetration testing teams and driving operational
      excellence — leveraging advanced adversary tradecraft and Agentic AI to
      proactively identify and mitigate complex enterprise threats.
    </p>

    <div class="mt-8 flex flex-wrap gap-3 font-mono text-xs">
      <span class="px-3 py-1.5 rounded border border-[var(--color-line)] bg-[var(--color-bg-soft)] text-[var(--color-fg-muted)]">
        <span class="text-[var(--color-accent)]">location</span>: Alexandria, VA
      </span>
      <span class="px-3 py-1.5 rounded border border-[var(--color-line)] bg-[var(--color-bg-soft)] text-[var(--color-fg-muted)]">
        <span class="text-[var(--color-accent)]">focus</span>: agentic_ai, cloud, FedRAMP
      </span>
      <span class="px-3 py-1.5 rounded border border-[var(--color-line)] bg-[var(--color-bg-soft)] text-[var(--color-fg-muted)]">
        <span class="text-[var(--color-accent)]">posture</span>: threat-informed
      </span>
    </div>
  </section>

  <!-- Summary -->
  <section class="mx-auto max-w-5xl px-5 sm:px-8 py-8 space-y-10">
    <TerminalWindow title="summary.txt" prompt="cat summary.txt">
      <p class="text-[var(--color-fg)] leading-relaxed">
        Strategic Offensive Security Leader with a proven track record of
        managing high-performing penetration testing teams and driving
        operational excellence. Adept at leveraging advanced adversary
        tradecraft and Agentic AI capabilities to proactively identify and
        mitigate complex enterprise threats. Recognized for strategic alignment,
        maintaining exceptionally low team turnover, and translating technical
        threat insights into actionable, business-relevant strategies for
        executive stakeholders.
      </p>
    </TerminalWindow>

    <!-- Core Competencies -->
    <TerminalWindow title="skills.json" prompt="cat skills.json | jq '.[].name'">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-6 font-mono text-sm">
        {competencies.map((group) => (
          <div>
            <div class="text-[var(--color-accent-2)] text-xs uppercase tracking-widest mb-2.5">
              {group.category}
            </div>
            <ul class="space-y-1.5">
              {group.items.map((item) => (
                <li class="flex gap-2 items-baseline text-[var(--color-fg)]">
                  <span class="text-[var(--color-accent)] shrink-0">›</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </TerminalWindow>

    <!-- Experience -->
    <TerminalWindow title="experience.json" prompt="cat experience.json | jq '.[] | {role, org, period}'">
      <ol class="space-y-8">
        {experience.map((job) => (
          <li class="relative pl-5 border-l border-[var(--color-line)]">
            <span class="absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full bg-[var(--color-accent)] shadow-[0_0_10px_var(--color-accent)]"></span>
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
              <h3 class="font-mono text-base sm:text-lg text-[var(--color-fg)]">
                {job.role}
              </h3>
              <span class="font-mono text-xs text-[var(--color-fg-dim)] tracking-wider">
                {job.period}
              </span>
            </div>
            <div class="font-mono text-xs text-[var(--color-accent-2)] mt-1">
              {job.org}
            </div>
            <ul class="mt-3 space-y-1.5 text-[var(--color-fg-muted)] leading-relaxed">
              {job.bullets.map((b) => (
                <li class="flex gap-2">
                  <span class="text-[var(--color-accent)] font-mono shrink-0">-</span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </TerminalWindow>

    <!-- Education + Certifications -->
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-10">
      <div class="lg:col-span-2">
        <TerminalWindow title="education.yml" prompt="cat education.yml">
          <ul class="space-y-3 font-mono text-sm">
            {education.map((e) => (
              <li>
                <div class="text-[var(--color-fg)]">{e.school}</div>
                <div class="text-[var(--color-fg-dim)] text-xs mt-0.5">{e.detail}</div>
              </li>
            ))}
          </ul>
        </TerminalWindow>
      </div>
      <div class="lg:col-span-3">
        <TerminalWindow title="certs.json" prompt="cat certs.json | jq '.[] | select(.active == true) | .name'">
          <ul class="space-y-3.5 font-mono text-sm">
            {certifications.map((c) => (
              <li class="flex gap-3 items-start">
                <span class="text-[var(--color-accent)] shrink-0 mt-0.5">[x]</span>
                <div>
                  <div class="text-[var(--color-fg)]">{c.name}</div>
                  <div class="text-[var(--color-fg-dim)] text-xs mt-0.5">{c.validity}</div>
                </div>
              </li>
            ))}
          </ul>
        </TerminalWindow>
      </div>
    </div>
  </section>
</BaseLayout>
