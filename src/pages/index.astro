---
import BaseLayout from "../layouts/BaseLayout.astro";
import TerminalWindow from "../components/TerminalWindow.astro";

const competencies = [
  { category: "Leadership", items: ["Executive Advisory (CISO-level)", "Strategic Budgeting & Roadmapping", "Talent Development & Retention", "Threat-Informed Defense Strategy", "SOC & Incident Response Integration"] },
  { category: "Agentic AI & Automation", items: ["Agentic AI Vulnerability Discovery", "LLM Security & Exploitation", "Claude Code · Gemini-CLI · Shannon AI", "AI Risk Management", "Automation Scaling"] },
  { category: "Offensive Security", items: ["Web Application Penetration Testing", "AWS · GCP · Azure Infrastructure Testing", "FedRAMP 3PAO Assessments", "Internal / External Penetration Testing", "Microsoft Azure & Office 365 Security"] },
  { category: "Tools & Languages", items: ["Bash · Python", "Burp Suite Pro · Tenable Nessus", "Rapid7 InsightVM · AppSpider Enterprise", "Bilingual: English & Spanish"] },
];

const experience = [
  {
    role: "Manager, Offensive Security",
    org: "Tevora Business Solutions, Inc, Fairfax, VA",
    period: "07/2022 to Present",
    bullets: [
      "Manage a team of 5 and a rotating bench of 2-3 interns per cycle, handling everything from scoping and delivery to career development.",
      "Act as a direct advisor to client CISOs and security leadership, turning complex findings into clear remediation roadmaps that fit their risk tolerance and business context.",
      "2x President's Club Award winner for consistently exceeding revenue goals; team is currently past $9.2M annually.",
      "Built out an Agentic AI testing practice using Claude Code, Gemini-CLI, and Shannon AI that has caught logic flaws and zero-days that both manual review and traditional scanners missed.",
      "Served as technical lead for the firm's FedRAMP 3PAO certification and ran cloud penetration tests for CSPs working toward FedRAMP Authorization.",
      "Kept team turnover near zero by building individual development paths; several engineers have gone on to earn OSWE and other advanced certifications.",
    ],
  },
  {
    role: "Information Security Consultant",
    org: "Tevora Business Solutions, Inc, Fairfax, VA",
    period: "03/2020 to 07/2022",
    bullets: [
      "Ran penetration tests and vulnerability assessments across network, web application, and cloud environments for clients in regulated industries.",
      "Covered internal and external testing as well as PCI-DSS scoped assessments.",
      "Wrote executive and technical reports that gave clients a clear picture of risk and a concrete path to fix it.",
    ],
  },
  {
    role: "Cyber Security Engineer",
    org: "State Corporation Commission, Richmond, VA",
    period: "01/2016 to 03/2020",
    bullets: [
      "Rebuilt the Vulnerability Management program to focus on validated, known-exploitable findings first, using Rapid7 InsightVM and AppSpider Enterprise to track and report risk to leadership.",
      "Led security for the Office 365/ADFS cloud migration, covering Exchange Online, Office Online, and SharePoint Online.",
      "Wrote Windows and Windows Server hardening standards based on DoD STIGs.",
      "Attended Black Hat 2017 and 2019 for hands-on training in red team techniques and cloud exploitation.",
    ],
  },
  {
    role: "Systems Analyst II, Risk and Security",
    org: "Virginia Premier Health Plan, Inc., Richmond, VA",
    period: "06/2013 to 01/2016",
    bullets: [
      "Helped stand up a security and risk program that was early-stage, writing SOPs and putting basic controls in place.",
      "Built a monthly patch management process for servers and launched a Security Awareness program with annual training, monthly newsletters, and quarterly contests.",
      "Deployed a SIEM to consolidate event logging and cut incident response time.",
    ],
  },
];

const education = [
  {
    school: "B.S. Information Systems, Spring 2013",
    detail: "Virginia Commonwealth University, Richmond, VA",
  },
];

const certifications = [
  { name: "CISSP: Certified Information Systems Security Professional", validity: "2023 to 2028" },
  { name: "GPEN: GIAC Penetration Tester", validity: "2019 to 2027" },
  { name: "OSCP: Offensive Security Certified Professional", validity: "2019" },
];
---
<BaseLayout>
  <!-- Hero -->
  <section class="mx-auto max-w-5xl px-5 sm:px-8 pt-16 sm:pt-24 pb-12">
    <h1 class="font-mono text-4xl sm:text-6xl font-semibold tracking-tight leading-[1.05]">
      <span class="text-[var(--color-fg-muted)]">&gt;</span>
      <span class="typewriter text-[var(--color-fg)]">jn0xa</span>
      <span class="ml-1 inline-block h-9 sm:h-12 w-2 align-middle bg-[var(--color-accent)] animate-pulse"></span>
    </h1>

    <p class="mt-5 max-w-2xl text-lg sm:text-xl text-[var(--color-fg-muted)] leading-relaxed">
      <span class="text-[var(--color-accent)]">Strategic Offensive Security Leader.</span>
      I run offensive security teams and build programs that use real adversary
      tradecraft and Agentic AI to find what other tools miss.
    </p>

    <div class="mt-8 flex flex-wrap gap-3 font-mono text-xs">
      <span class="px-3 py-1.5 rounded border border-[var(--color-line)] bg-[var(--color-bg-soft)] text-[var(--color-fg-muted)]">
        <span class="text-[var(--color-accent)]">location</span>: Alexandria, VA
      </span>
      <span class="px-3 py-1.5 rounded border border-[var(--color-line)] bg-[var(--color-bg-soft)] text-[var(--color-fg-muted)]">
        <span class="text-[var(--color-accent)]">focus</span>: agentic_ai, cloud, FedRAMP
      </span>
      <span class="px-3 py-1.5 rounded border border-[var(--color-line)] bg-[var(--color-bg-soft)] text-[var(--color-fg-muted)]">
        <span class="text-[var(--color-accent)]">posture</span>: threat-informed
      </span>
    </div>
  </section>

  <!-- Summary -->
  <section class="mx-auto max-w-5xl px-5 sm:px-8 py-8 space-y-10">
    <TerminalWindow title="summary.txt" prompt="cat summary.txt">
      <p class="font-mono text-sm text-[var(--color-fg)] leading-relaxed">
        I've spent the last decade doing penetration testing, red teaming, and
        building offensive security programs from the ground up. These days I
        lead teams and own the strategy, but I stay close to the technical work
        because that's what makes the leadership credible. I care a lot about
        developing the people on my teams and creating an environment where
        strong practitioners actually want to stay. Right now I'm thinking hard
        about where Agentic AI fits into offensive security and what it changes
        for defenders.
      </p>
    </TerminalWindow>

    <!-- Core Competencies -->
    <TerminalWindow title="skills.json" prompt="cat skills.json | jq '.[].name'">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-6 font-mono text-sm">
        {competencies.map((group) => (
          <div>
            <div class="text-[var(--color-accent-2)] text-xs uppercase tracking-widest mb-2.5">
              {group.category}
            </div>
            <ul class="space-y-1.5">
              {group.items.map((item) => (
                <li class="flex gap-2 items-baseline text-[var(--color-fg)]">
                  <span class="text-[var(--color-accent)] shrink-0">›</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </TerminalWindow>

    <!-- Experience -->
    <TerminalWindow title="experience.json" prompt="cat experience.json | jq '.[] | {role, org, period}'">
      <ol class="space-y-8">
        {experience.map((job) => (
          <li class="relative pl-5 border-l border-[var(--color-line)]">
            <span class="absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full bg-[var(--color-accent)] shadow-[0_0_10px_var(--color-accent)]"></span>
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
              <h3 class="font-mono text-base sm:text-lg text-[var(--color-fg)]">
                {job.role}
              </h3>
              <span class="font-mono text-xs text-[var(--color-fg-dim)] tracking-wider">
                {job.period}
              </span>
            </div>
            <div class="font-mono text-xs text-[var(--color-accent-2)] mt-1">
              {job.org}
            </div>
            <ul class="mt-3 space-y-1.5 font-mono text-sm text-[var(--color-fg-muted)] leading-relaxed">
              {job.bullets.map((b) => (
                <li class="flex gap-2">
                  <span class="text-[var(--color-accent)] font-mono shrink-0">-</span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </TerminalWindow>

    <!-- Education + Certifications -->
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-10">
      <div class="lg:col-span-2">
        <TerminalWindow title="education.yml" prompt="cat education.yml">
          <ul class="space-y-3 font-mono text-sm">
            {education.map((e) => (
              <li>
                <div class="text-[var(--color-fg)]">{e.school}</div>
                <div class="text-[var(--color-fg-dim)] text-xs mt-0.5">{e.detail}</div>
              </li>
            ))}
          </ul>
        </TerminalWindow>
      </div>
      <div class="lg:col-span-3">
        <TerminalWindow title="certs.json" prompt="cat certs.json | jq '.[] | select(.active == true) | .name'">
          <ul class="space-y-3.5 font-mono text-sm">
            {certifications.map((c) => (
              <li class="flex gap-3 items-start">
                <span class="text-[var(--color-accent)] shrink-0 mt-0.5">[x]</span>
                <div>
                  <div class="text-[var(--color-fg)]">{c.name}</div>
                  <div class="text-[var(--color-fg-dim)] text-xs mt-0.5">{c.validity}</div>
                </div>
              </li>
            ))}
          </ul>
        </TerminalWindow>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  @keyframes typing {
    from { width: 0ch; }
    to   { width: 5ch; }
  }

  .typewriter {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    width: 5ch;
    animation: typing 0.9s steps(5, end) both;
  }
</style>
