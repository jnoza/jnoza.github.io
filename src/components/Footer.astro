---
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-[var(--color-line)]">
  <div class="mx-auto max-w-5xl px-5 sm:px-8 py-8 flex flex-row items-center justify-between font-mono text-xs text-[var(--color-fg-dim)]">
    <div>
      <span class="text-[var(--color-fg-muted)]">//</span> &copy; {year} jn0xa
    </div>
    <div class="flex items-center gap-2">
      <span class="inline-block h-2 w-2 rounded-full bg-[#EF0107]"></span>
      <span class="text-[var(--color-fg-muted)]">COYG</span>
    </div>
  </div>
</footer>
