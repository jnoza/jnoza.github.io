---
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-[var(--color-line)]">
  <div class="mx-auto max-w-5xl px-5 sm:px-8 py-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 font-mono text-xs text-[var(--color-fg-dim)]">
    <div>
      <span class="text-[var(--color-fg-muted)]">//</span> &copy; {year} jn0xa &mdash; built with astro &middot; static &middot; zero js
    </div>
    <div class="flex items-center gap-2">
      <span class="inline-block h-2 w-2 rounded-full bg-[#EF0107] shadow-[0_0_8px_#EF0107]"></span>
      <span class="text-[var(--color-fg-muted)]">COYG</span>
    </div>
  </div>
</footer>
