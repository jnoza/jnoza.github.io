---
interface Props {
  title?: string;
  prompt?: string;
  class?: string;
}
const { title = "zsh", prompt, class: className = "" } = Astro.props;
---
<section class={`group relative rounded-lg border border-[var(--color-line)] bg-[var(--color-bg-elev)] shadow-[0_4px_16px_rgba(0,0,0,0.5)] ${className}`}>
  <header class="flex items-center gap-3 border-b border-[var(--color-line)] bg-[var(--color-bg-soft)] px-4 py-2.5 rounded-t-lg">
    <div class="flex items-center gap-1.5">
      <span class="h-3 w-3 rounded-full bg-[#ff5f57] border border-black/30"></span>
      <span class="h-3 w-3 rounded-full bg-[#febc2e] border border-black/30"></span>
      <span class="h-3 w-3 rounded-full bg-[#28c840] border border-black/30"></span>
    </div>
    <div class="flex-1 text-center font-mono text-xs text-[var(--color-fg-muted)] tracking-tight">
      {title}
    </div>
    <div class="font-mono text-[10px] text-[var(--color-fg-dim)] uppercase tracking-widest hidden sm:block">
      tty.0
    </div>
  </header>
  <div class="px-5 py-5 sm:px-7 sm:py-6">
    {prompt && (
      <div class="mb-5 font-mono text-xs sm:text-sm">
        <span class="text-[var(--color-accent-2)]">jn0xa@offsec</span><span class="text-[var(--color-fg-dim)]">:</span><span class="text-[var(--color-accent)]">~</span><span class="text-[var(--color-fg-dim)]">$ </span><span class="text-[var(--color-fg)]">{prompt}</span><span class="ml-1 inline-block h-3.5 w-1.5 align-middle bg-[var(--color-accent)] animate-pulse"></span>
      </div>
    )}
    <slot />
  </div>
</section>
